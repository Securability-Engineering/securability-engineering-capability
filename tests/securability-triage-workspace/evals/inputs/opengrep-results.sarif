          "level": "error",
          "message": { "text": "SQL query built with f-string interpolating user-controlled variable 'item_id'" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/flask_inventory.py" },
                "region": { "startLine": 72 }
              }
            }
          ],
          "partialFingerprints": { "primaryLocationLineHash": "abcdef01" }
        },
        {
          "ruleId": "securable-jwt-decode-unpinned",
          "level": "warning",
          "message": { "text": "jwt.decode called without specifying algorithms parameter" },
          "locations": [
            {
              "physicalLocation": {
