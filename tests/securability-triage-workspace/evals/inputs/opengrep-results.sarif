        },
        {
          "ruleId": "securable-sql-fstring",
          "level": "error",
          "message": { "text": "SQL query built with f-string interpolating user-controlled values" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/flask_inventory.py" },
                "region": { "startLine": 54 }
              }
            }
          ],
          "partialFingerprints": { "primaryLocationLineHash": "c9d0e1f2" }
        },
        {
          "ruleId": "securable-sql-fstring",
          "level": "error",
          "message": { "text": "SQL query built with f-string interpolating user-controlled variables 'start' and 'end'" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/flask_inventory.py" },
                "region": { "startLine": 86 }
